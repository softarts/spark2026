# Shared settings for startcluster.sh / stopcluster.sh / scripts/*.sh.
# Sourced by bash; keep to plain KEY=value lines.

# Docker Desktop's built-in Kubernetes. Scripts pass --context explicitly and
# never switch your current kubectl context.
LAB_CONTEXT=docker-desktop
LAB_NAMESPACE=spark-lab
INGRESS_NAMESPACE=traefik

# External port published on every Mac network interface by Traefik.
# If you change it, also change MINIO_BROWSER_REDIRECT_URL in k8s/30-silo.yaml
# and ports.web.exposedPort in traefik/values.yaml.
LAB_PORT=8080

# Unified runtime image for Notebook, Driver and Executors (images/Dockerfile).
RUNTIME_NAME=spark-lab-runtime
RUNTIME_TAG=0.3.0

# Pinned Helm charts.
TRAEFIK_CHART_VERSION=42.4.1        # Traefik Proxy v3.7.19
JUPYTERHUB_CHART_VERSION=4.4.5      # JupyterHub 5.5.5
HEADLAMP_CHART_VERSION=0.46.0       # Headlamp v0.46.0 (admin-only Kubernetes UI)
HEADLAMP_NAMESPACE=headlamp

# Bucket created on start (idempotent).
SILO_BUCKET=spark-data
